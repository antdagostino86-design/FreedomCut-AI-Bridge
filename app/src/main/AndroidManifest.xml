<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
 <uses-permission android:name="android.permission.INTERNET"/>
 <queries><package android:name="com.lemon.lvoverseas"/></queries>
 <application android:label="FreedomCut AI Bridge" android:theme="@android:style/Theme.Material.Light.NoActionBar" android:allowBackup="false" android:usesCleartextTraffic="false">
  <activity android:name=".MainActivity" android:exported="true">
   <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
  </activity>
  <service android:name=".CapCutService" android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE" android:exported="true">
   <intent-filter><action android:name="android.accessibilityservice.AccessibilityService"/></intent-filter>
   <meta-data android:name="android.accessibilityservice" android:resource="@xml/accessibility_config"/>
  </service>
 </application>
</manifest>